\@writefile{toc}{\contentsline {subsection}{\numberline {1.18}The coupled-slab switch was off for \texttt  {\small  develop}/\texttt  {\small  develop-cc}; the sea-ice climate validated on a clean decade (2026-07-23$\to $27)}{26}{subsection.1.18}\protected@file@percent }
\newlabel{sec:nammcc}{{1.18}{26}{The coupled-slab switch was off for \code {develop}/\code {develop-cc}; the sea-ice climate validated on a clean decade (2026-07-23$\to $27)}{subsection.1.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {19}{\ignorespaces \texttt  {\small  develop} sea-ice thickness after the \texttt  {\small  NAMMCC} coupled-slab fix, native CORE3 grid, 5-yr mean of spin-up years 6--10, zoomed to the polar caps. Columns: control (fixed \texttt  {\small  develop}), the tuning experiment (\S  \ref {sec:state}), and an independent 500-year CMIP7 pre-industrial spin-up (a270270) at the same spin-up age. Rows: NH March (max), NH September (min), SH September (max), SH February (min); element counts with $a_\mathrm  {ice}>0.15$ annotated. The NH September row --- blank (``NO ICE'') before the fix --- now carries a coherent central Arctic pack \emph  {exceeding} the reference (27.7k vs 21.1k elements). The large-scale fields match the reference spin-up hemisphere-by-hemisphere; the coupled-slab config is correct.}}{28}{figure.19}\protected@file@percent }
\newlabel{fig:si10y-maps}{{19}{28}{\code {develop} sea-ice thickness after the \code {NAMMCC} coupled-slab fix, native CORE3 grid, 5-yr mean of spin-up years 6--10, zoomed to the polar caps. Columns: control (fixed \code {develop}), the tuning experiment (\S \ref {sec:state}), and an independent 500-year CMIP7 pre-industrial spin-up (a270270) at the same spin-up age. Rows: NH March (max), NH September (min), SH September (max), SH February (min); element counts with $a_\mathrm {ice}>0.15$ annotated. The NH September row --- blank (``NO ICE'') before the fix --- now carries a coherent central Arctic pack \emph {exceeding} the reference (27.7k vs 21.1k elements). The large-scale fields match the reference spin-up hemisphere-by-hemisphere; the coupled-slab config is correct}{figure.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {20}{\ignorespaces \texttt  {\small  develop}+fix (blue) vs a270270's CMIP7 pre-industrial spin-up (orange), first 10 years of each. (a,b) NH/SH seasonal extent, band = year-range; green markers = observed. (c) NH March volume; (d) single-point max thickness --- the unbounded drift is present in \emph  {both} runs (shared model artifact). Large-scale sea ice matches the reference; where the two differ, the fixed run sits closer to observations.}}{29}{figure.20}\protected@file@percent }
\newlabel{fig:si10y-vs-ref}{{20}{29}{\code {develop}+fix (blue) vs a270270's CMIP7 pre-industrial spin-up (orange), first 10 years of each. (a,b) NH/SH seasonal extent, band = year-range; green markers = observed. (c) NH March volume; (d) single-point max thickness --- the unbounded drift is present in \emph {both} runs (shared model artifact). Large-scale sea ice matches the reference; where the two differ, the fixed run sits closer to observations}{figure.20}{}}
